generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                   Int              @id @default(autoincrement())
  name                 String
  slug                 String           @unique
  sku                  String?          @unique
  description          String?
  brand                String?
  model                String?
  manufacturingCountry String?
  condition            ProductCondition @default(NEW)
  price                Float
  listPrice            Float?
  stock                Int              @default(0)
  inventoryStatus      InventoryStatus  @default(IN_STOCK)
  isActive             Boolean          @default(true)
  featured             Boolean          @default(false)
  powerSource          PowerSource?     @default(ELECTRIC)
  voltage              String?
  phase                Int?
  power                String?
  powerConsumption     Float?
  coolingSystem        CoolingSystem?
  width                Float?
  depth                Float?
  height               Float?
  weightNet            Float?
  weightGross          Float?
  images               String[]         @default([])
  thumbnail            String?
  files                String[]         @default([])
  subcategoryId        Int?
  tags                 String[]         @default([])
  specifications       Json?
  features             String[]         @default([])
  warranty             String?
  metaTitle            String?
  metaDescription      String?
  keywords             String[]         @default([])
  rating               Float?           @default(0)
  reviewCount          Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  installmentEnabled   Boolean          @default(false)
  installmentTerms     Json?
  subcategory          Subcategory?     @relation(fields: [subcategoryId], references: [id])
  variants             ProductVariant[]

  @@index([slug])
  @@index([subcategoryId])
  @@index([brand])
  @@index([sku])
  @@index([isActive])
  @@index([featured])
}

model ProductVariant {
  id              Int             @id @default(autoincrement())
  productId       Int
  sku             String?         @unique
  name            String
  capacity        String?
  phase           Int?
  voltage         String?
  price           Float
  listPrice       Float?
  stock           Int             @default(0)
  inventoryStatus InventoryStatus @default(IN_STOCK)
  specifications  Json?
  isActive        Boolean         @default(true)
  isDefault       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  description   String?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String
  description String?
  categoryId  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  category    Category  @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model User {
  id        Int        @id @default(autoincrement())
  phone     String     @unique
  name      String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  addresses Address[]

  @@index([phone])
}

model Address {
  id         Int      @id @default(autoincrement())
  city       String
  province   String?
  address    String
  postalCode String?
  isDefault  Boolean  @default(false)
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Admin {
  id        Int         @id @default(autoincrement())
  phone     String      @unique
  name      String?
  role      AdminRole   @default(ADMIN)
  status    AdminStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([phone])
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum PowerSource {
  ELECTRIC
  GAS
  HYBRID
}

enum CoolingSystem {
  AIR
  WATER
  MIXED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  DISCONTINUED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum AdminStatus {
  ACTIVE
  BLOCKED
}
