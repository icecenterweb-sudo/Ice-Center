generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                   Int              @id @default(autoincrement())
  name                 String
  slug                 String           @unique
  sku                  String?          @unique
  description          String?
  brand                String?
  model                String?
  manufacturingCountry String?
  condition            ProductCondition @default(NEW)
  price                Decimal          @db.Decimal(14, 2)
  listPrice            Decimal?         @db.Decimal(14, 2)
  stock                Int              @default(0)
  inventoryStatus      InventoryStatus  @default(IN_STOCK)
  isActive             Boolean          @default(true)
  featured             Boolean          @default(false)
  powerSource          PowerSource?     @default(ELECTRIC)
  voltage              String?
  phase                Int?
  power                String?
  powerConsumption     Float?
  coolingSystem        CoolingSystem?
  width                Float?
  depth                Float?
  height               Float?
  weightNet            Float?
  weightGross          Float?
  images               String[]         @default([])
  thumbnail            String?
  files                String[]         @default([])
  subcategoryId        Int?
  tags                 String[]         @default([])
  specifications       Json?
  features             String[]         @default([])
  warranty             String?
  metaTitle            String?
  metaDescription      String?
  keywords             String[]         @default([])
  rating               Float?           @default(0)
  reviewCount          Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  installmentEnabled   Boolean          @default(false)
  installmentTerms     Json?
  
  // Offer System
  hasActiveOffer       Boolean          @default(false)  // Denormalized flag for fast queries
  
  // Relations
  subcategory          Subcategory?     @relation(fields: [subcategoryId], references: [id])
  variants             ProductVariant[]
  cartItems            CartItem[]
  offerProducts        OfferProduct[]   // Many-to-many with Offers
  slides               Slide[]          // Hero slider slides linking to this product
  banners              Banner[]         // Banners linking to this product
  wishlistItems        WishlistItem[]   // Wishlist items
  analyticsEvents      AnalyticsEvent[]
  reviews              ProductReview[]

  @@index([subcategoryId])
  @@index([brand])
  @@index([sku])
  @@index([isActive])
  @@index([featured])
  @@index([hasActiveOffer])
  @@index([isActive, createdAt])  // Composite index for list queries with ordering
}

model ProductVariant {
  id              Int             @id @default(autoincrement())
  productId       Int
  sku             String?         @unique
  name            String
  capacity        String?
  phase           Int?
  voltage         String?
  price           Decimal         @db.Decimal(14, 2)
  listPrice       Decimal?        @db.Decimal(14, 2)
  stock           Int             @default(0)
  inventoryStatus InventoryStatus @default(IN_STOCK)
  specifications  Json?
  isActive        Boolean         @default(true)
  isDefault       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  description   String?
  image         String?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  slides        Slide[]       // Hero slider slides linking to this category
  banners       Banner[]      // Banners linking to this category

  @@index([order])
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String
  description String?
  categoryId  Int
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  category    Category  @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([categoryId, order])
}

model User {
  id         Int        @id @default(autoincrement())
  phone      String     @unique
  firstName  String?
  lastName   String?
  isVerified Boolean    @default(false)
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  addresses       Address[]
  cartItems       CartItem[]
  blogComments    BlogComment[]
  orders          Order[]
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  analyticsEvents AnalyticsEvent[]
  supportRooms    SupportRoom[]
  reviews         ProductReview[]
  couponUsages    CouponUsage[]

}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model OtpRequest {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model Address {
  id         Int      @id @default(autoincrement())
  city       String
  province   String?
  address    String
  postalCode String?
  isDefault  Boolean  @default(false)
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Admin {
  id        Int         @id @default(autoincrement())
  phone     String      @unique
  name      String?
  roles     AdminRole[] @default([])
  status    AdminStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  blogPosts       BlogPost[]
  analyticsEvents AnalyticsEvent[]
  supportMessages SupportMessage[]
  auditLogs       AuditLog[]
  reviews         ProductReview[]

}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g., "PRODUCT_CREATE", "PRICE_UPDATE", "STOCK_UPDATE", "ORDER_STATUS_UPDATE"
  entity    String   // e.g., "Product", "Order"
  entityId  Int
  details   String?  // JSON string or summary of changes
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum PowerSource {
  ELECTRIC
  GAS
  HYBRID
}

enum CoolingSystem {
  AIR
  WATER
  MIXED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  DISCONTINUED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AdminRole {
  SUPER_ADMIN
  GENERAL_MANAGER
  BLOG_WRITER
  SUPPORT_ADMIN
  INVENTORY_MANAGER
  ADMIN
  EDITOR
}

enum AdminStatus {
  ACTIVE
  BLOCKED
}

// Blog System
enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model BlogPost {
  id             Int           @id @default(autoincrement())
  title          String        @db.VarChar(200)
  slug           String        @unique
  summary        String?       @db.VarChar(160)
  coverImage     String?
  thumbnail      String?
  content        Json          // Tiptap block data
  
  // SEO
  seoTitle       String?       @db.VarChar(60)
  seoDescription String?       @db.VarChar(160)
  keywords       String[]      @default([])
  
  // Publishing
  status         PostStatus    @default(DRAFT)
  publishedAt    DateTime?
  
  // Relations
  categoryId     Int?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  tags           BlogTag[]
  authorId       Int?
  author         Admin?        @relation(fields: [authorId], references: [id])
  
  comments       BlogComment[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
}

model BlogCategory {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image       String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

}

model BlogTag {
  id    Int        @id @default(autoincrement())
  name  String
  slug  String     @unique
  posts BlogPost[]

}

// Blog Comments/Reviews
model BlogComment {
  id        Int           @id @default(autoincrement())
  postId    Int
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Optional user relation (for logged-in users)
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  
  // For guest comments
  authorName  String?
  authorEmail String?
  
  content   String        @db.Text
  status    CommentStatus @default(PENDING)
  
  // Threaded replies
  parentId  Int?
  parent    BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   BlogComment[] @relation("CommentReplies")
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([status])
  @@index([parentId])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// OFFER SYSTEM
// =============================================================================

enum DiscountType {
  PERCENTAGE    // e.g., 20% off
  FIXED_AMOUNT  // e.g., 50,000 Toman off
}

model Offer {
  id              Int          @id @default(autoincrement())
  
  // Identity
  name            String       // "یلدا ویژه"
  slug            String?      @unique
  description     String?
  
  // Discount Configuration
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Decimal      @db.Decimal(14, 2)  // 20 for 20%, or 50000 for fixed amount
  maxDiscountCap  Decimal?     @db.Decimal(14, 2)  // Optional: cap for percentage discounts
  
  // Timing
  startDate       DateTime     @default(now())
  endDate         DateTime
  
  // Control
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)  // Show in carousel
  priority        Int          @default(0)       // Higher wins conflicts
  
  // Display
  badgeText       String?      // "۲۰٪ تخفیف"
  badgeColor      String?      // Hex color for badge
  
  // Campaign grouping
  campaignId      Int?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  
  // Products (many-to-many)
  products        OfferProduct[]
  
  // Audit
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([isActive, isFeatured, startDate, endDate])
  @@index([isActive, startDate, endDate])
  @@index([campaignId])
  @@index([priority])
}

// Junction table for many-to-many Offer <-> Product
model OfferProduct {
  id                  Int      @id @default(autoincrement())
  offerId             Int
  offer               Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Optional: Override discount for this specific product
  customDiscountValue Decimal? @db.Decimal(14, 2)
  
  createdAt           DateTime @default(now())
  
  @@unique([offerId, productId])
  @@index([productId])
  @@index([offerId])
}

// Campaign for grouping offers
model Campaign {
  id          Int      @id @default(autoincrement())
  name        String   // "یلدا ۱۴۰۳"
  slug        String   @unique
  description String?
  bannerUrl   String?
  themeColor  String?  // Hex color for styling
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, startDate, endDate])
}

// Hero Slider Slides
model Slide {
  id            Int       @id @default(autoincrement())
  title         String?
  desktopImage  String
  mobileImage   String
  alt           String
  
  // Link options: custom URL, product, or category
  link          String?   // Custom URL (optional)
  productId     Int?      // Link to product (optional)
  categoryId    Int?      // Link to category (optional)
  
  isActive      Boolean   @default(true)
  order         Int       @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  @@index([isActive, order])
}

// Banner Position Types
enum BannerPosition {
  SINGLE_FULL   // تک بنر تمام‌عرض
  DOUBLE        // دو بنر کنار هم
}

// Homepage Banners
model Banner {
  id            Int            @id @default(autoincrement())
  title         String         // عنوان برای مدیریت
  position      BannerPosition // موقعیت نمایش
  desktopImage  String         // تصویر دسکتاپ
  mobileImage   String         // تصویر موبایل
  alt           String         // متن جایگزین
  
  // Link options: custom URL, product, or category
  link          String?        // لینک مستقیم (اختیاری)
  productId     Int?           // لینک به محصول (اختیاری)
  categoryId    Int?           // لینک به دسته‌بندی (اختیاری)
  
  order         Int            @default(0)  // ترتیب نمایش
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  @@index([position, isActive, order])
}

// =============================================================================
// ORDER SYSTEM
// =============================================================================

enum OrderStatus {
  PENDING              // در انتظار پرداخت
  AWAITING_CONFIRMATION // در انتظار تأیید کارشناس
  PAID                 // پرداخت شده
  PROCESSING           // در حال پردازش
  PREPARING            // آماده‌سازی
  READY_FOR_DELIVERY   // آماده تحویل
  SHIPPED              // ارسال شده
  HANDED_TO_CARRIER    // تحویل به باربری
  DELIVERED            // تحویل داده شده
  RETURNED             // برگشت خورده
  CANCELLED            // لغو شده
  NEEDS_CONTACT        // نیازمند تماس
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique  // شماره سفارش یکتا
  
  // Customer Info (denormalized for history)
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  customerName    String      // نام مشتری (snapshot)
  customerPhone   String      // شماره تماس (snapshot)
  
  // Shipping Address (snapshot)
  shippingAddress String      // آدرس ارسال
  shippingCity    String      // شهر
  shippingProvince String?    // استان
  postalCode      String?     // کد پستی
  
  // Order Details
  items           OrderItem[]
  subtotal        Decimal     @db.Decimal(14, 2)  // جمع قبل از تخفیف
  discount        Decimal     @default(0) @db.Decimal(14, 2)
  shippingCost    Decimal     @default(0) @db.Decimal(14, 2)
  total           Decimal     @db.Decimal(14, 2)  // جمع کل
  
  // Status & Notes
  status          OrderStatus @default(PENDING)
  notes           String?     // یادداشت مشتری
  adminNotes      String?     // یادداشت ادمین (internal)
  analyticsEvents AnalyticsEvent[]
  couponUsage     CouponUsage?
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paidAt          DateTime?   // زمان پرداخت
  confirmedAt     DateTime?   // زمان تأیید کارشناس
  preparingAt     DateTime?   // زمان شروع آماده‌سازی
  readyAt         DateTime?   // زمان آماده تحویل
  shippedAt       DateTime?   // زمان ارسال
  handedToCarrierAt DateTime? // زمان تحویل به باربری
  deliveredAt     DateTime?   // زمان تحویل
  returnedAt      DateTime?   // زمان برگشت
  cancelledAt     DateTime?   // زمان لغو
  
  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Product Info (snapshot - doesn't change if product is updated)
  productId   Int
  productName String   // نام محصول
  productSku  String?  // کد محصول
  thumbnail   String?  // تصویر محصول
  
  // Pricing
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 2)  // قیمت واحد
  totalPrice  Decimal  @db.Decimal(14, 2)  // قیمت کل (quantity * unitPrice)
  
  createdAt   DateTime @default(now())
  
  @@index([orderId])
  @@index([productId])
}

// =============================================================================
// WISHLIST SYSTEM
// =============================================================================

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// =============================================================================
// NOTIFICATION SYSTEM
// =============================================================================

enum NotificationType {
  ORDER       // Order status updates
  PROMO       // Promotions and campaigns
  PRICE       // Price drop alerts
  STOCK       // Back in stock alerts
  SYSTEM      // System announcements
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?          // Optional redirect URL (e.g. /profile/orders/123)
  readAt    DateTime?        // null = unread, timestamp = read
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])  // For unread count queries
  @@index([createdAt])
}

// =============================================================================
// FIRST-PARTY ANALYTICS
// =============================================================================

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  ORDER_SUBMIT
  PAYMENT_SUCCESS
  SEARCH
  SPEED_LOG
  USER_LOGIN
  ADMIN_LOGIN
}

model AnalyticsEvent {
  id        Int                @id @default(autoincrement())
  type      AnalyticsEventType

  path      String?
  referrer  String?
  source    String             @default("direct")
  medium    String?
  device    String?
  userAgent String?
  ipHash    String?
  browser   String?

  userId    Int?
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminId   Int?
  admin     Admin?             @relation(fields: [adminId], references: [id], onDelete: SetNull)

  // Extended fields for Phase 5 Analytics
  productId           Int?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId             Int?
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  searchQuery         String?
  searchResultCount   Int?
  loadTime            Float?             // for page speed (ms)
  imageSize           Float?             // for speed/payload size (KB)
  hasErrors           Boolean?           @default(false)

  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([productId, createdAt])
  @@index([orderId, createdAt])
}

// =============================================================================
// SUPPORT CHAT SYSTEM
// =============================================================================

enum SupportRoomStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  USER
  ADMIN
}

model SupportRoom {
  id        Int               @id @default(autoincrement())
  phone     String
  name      String
  userId    Int?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    SupportRoomStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  SupportMessage[]

  @@index([phone])
  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  roomId    Int
  room      SupportRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    MessageSender
  text      String        @db.Text
  createdAt DateTime      @default(now())

  adminId   Int?
  admin     Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([roomId, createdAt])
}

// =============================================================================
// PRODUCT REVIEWS
// =============================================================================

enum ReviewStatus {
  PENDING     // منتظر تأیید ادمین
  APPROVED    // تأیید شده و قابل نمایش
  REJECTED    // رد شده
}

model ProductReview {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating    Int          // 1-5
  title     String?
  comment   String       @db.Text
  status    ReviewStatus @default(PENDING)

  // Admin moderation
  adminId   Int?
  admin     Admin?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminNote String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([productId, status])
  @@index([userId])
  @@index([status])
}

// =============================================================================
// COUPONS / DISCOUNT CODES
// =============================================================================

enum CouponType {
  PERCENTAGE   // درصدی
  FIXED_AMOUNT // مبلغ ثابت
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Coupon {
  id              Int          @id @default(autoincrement())
  code            String       @unique  // کد تخفیف
  type            CouponType
  value           Decimal      @db.Decimal(14, 2)  // درصد یا مبلغ (تومان)
  minOrderAmount  Decimal?     @db.Decimal(14, 2)  // حداقل مبلغ سفارش برای اعمال
  maxDiscount     Decimal?     @db.Decimal(14, 2)  // سقف تخفیف (برای نوع درصدی)

  status          CouponStatus @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  usageLimit      Int?         // سقف کل استفاده
  usedCount       Int          @default(0)
  perUserLimit    Int          @default(1)  // سقف استفاده هر کاربر

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  usages          CouponUsage[]

  @@index([status])
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int      @unique  // هر سفارش فقط یک کوپن
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount  Decimal  @db.Decimal(14, 2)  // مبلغ تخفیف اعمال شده
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  stack     String?  @db.Text
  path      String?
  severity  String   @default("ERROR") // "INFO", "WARNING", "ERROR", "CRITICAL"
  createdAt DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

